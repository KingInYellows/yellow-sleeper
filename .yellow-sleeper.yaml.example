# Synthetic example — replace with your own league identity.
# Copy this file to `.yellow-sleeper.yaml` (or another path via YELLOW_SLEEPER_CONFIG).
sleeper_league_id: "example-league-id"
sleeper_username: example_user
league_format: 14-team SF PPR 0.5 TEP
tep: 0.5
xlsx_enabled: false
# xlsx_path: ./values.xlsx
cache_dir: .cache

policy_override:
  hard_untouchables:
    - Drake London
    - Harold Fannin

  protected_players:
    - Jayden Daniels
    - Jaxon Smith-Njigba

  protected_pick_patterns:
    - 2027 1st
    - 2028 1st
