# Copy to .yellow-sleeper.yaml and set your league identity.
# Static keys: YAML beats environment variables.
# Policy lists: YAML beats env; tool arguments beat YAML.
# There is no default league or username.

sleeper_league_id: "1234567890"
sleeper_username: casey
league_format: "14-team SF PPR 0.5 TEP"
tep_tier: te+
cache_dir: .cache

# Optional local CSV overlay keyed by sleeper_id (contract source name stays xlsx).
# Copy .yellow-sleeper-values.csv.example to .yellow-sleeper-values.csv.
# Unset keeps FantasyCalc only. A configured missing file is an explicit status,
# not a silent FantasyCalc fallback labeled as overlay.
# values_overlay_path: .yellow-sleeper-values.csv

# Fictional example policy — replace with your own names. These are not
# a copied operator untouchable list.
hard_untouchables:
  - Example Franchise Quarterback
protected_players:
  - Example Young Wide Receiver
protected_pick_patterns:
  - 2029 1st
